<Window
    x:Class="Test1.Window2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Test1"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DpiUtil 示例窗口"
    Width="960"
    Height="540"
    mc:Ignorable="d">
    <Grid x:Name="gdMain" Background="#f0f0f0">
        <Grid
            Height="50"
            VerticalAlignment="Top"
            Background="#2c3e50">
            <StackPanel
                Margin="20,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="DpiUtil 响应式布局示例" />
                <TextBlock
                    x:Name="DpiInfoText"
                    Margin="20,0,0,0"
                    FontSize="14"
                    Foreground="White"
                    Text="DPI信息：" />
                <TextBlock
                    x:Name="WindowSizeInfoText"
                    Margin="20,0,0,0"
                    FontSize="14"
                    Foreground="White"
                    Text="窗口尺寸：" />
            </StackPanel>
        </Grid>

        <StackPanel Margin="20,70,20,20" Orientation="Vertical">
            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                <Border
                    Width="300"
                    Height="150"
                    Margin="10,10,10,10"
                    Background="#3498db">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="响应式尺寸 (300x150)" />
                </Border>

                <Border
                    Width="500"
                    Height="150"
                    Margin="10,10,10,10"
                    Background="#e74c3c">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="响应式尺寸 (500x150)" />
                </Border>
            </StackPanel>

            <Border BorderBrush="Red" BorderThickness="1">
                <Border
                    Margin="20,10,20,10"
                    Padding="30"
                    Background="#2ecc71"
                    CornerRadius="15">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="响应式边距 (20,10,20,10)、内边距 (30) 和圆角 (15)" />
                </Border>
            </Border>

            <StackPanel
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="150"
                    Height="40"
                    Padding="10"
                    Background="#9b59b6"
                    Content="响应式按钮 1"
                    FontSize="14"
                    Foreground="White" />
                <Button
                    Width="200"
                    Height="40"
                    Margin="20,0,0,0"
                    Padding="10"
                    Background="#f39c12"
                    Content="响应式按钮 2"
                    FontSize="14"
                    Foreground="White" />
            </StackPanel>

            <StackPanel
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <TextBlock FontSize="12" Text="响应式字体大小 12px" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="16"
                    Text="响应式字体大小 16px" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="20"
                    Text="响应式字体大小 20px" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="24"
                    Text="响应式字体大小 24px" />
            </StackPanel>

            <Grid Margin="20" Background="#ecf0f1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#3498db"
                    FontSize="14"
                    Foreground="White"
                    Text="网格单元格 1" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#e74c3c"
                    FontSize="14"
                    Foreground="White"
                    Text="网格单元格 2" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#2ecc71"
                    FontSize="14"
                    Foreground="White"
                    Text="网格单元格 3" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#f39c12"
                    FontSize="14"
                    Foreground="White"
                    Text="网格单元格 4" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
